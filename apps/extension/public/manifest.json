{
  "manifest_version": 3,
  "default_locale": "en",
  "name": "__MSG_appName__",
  "version": "1.0.0",
  "description": "__MSG_appDesc__",
  "key": "",
  "permissions": [
    "storage",
    "activeTab",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>",
    "file:///*"
  ],
  "background": {
    "service_worker": "serviceWorker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*/*.md*",
        "*://*/*.markdown*",
        "file:///*/*.md*",
        "file:///*/*.markdown*"
      ],
      "js": ["contentScriptLoader.js"],
      "css": ["contentScript.css"],
      "run_at": "document_end"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Markdown Reader",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "onboarding.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "contentScript.js",
        "assets/*",
        "*.css",
        "*.woff",
        "*.woff2",
        "*.ttf"
      ],
      "matches": [
        "<all_urls>",
        "file:///*"
      ]
    }
  ]
}
